{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tiny Chat Lab lesson v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "title", "zone", "minutes", "prerequisites", "objectives", "prediction", "explanation", "analogy_limit", "python_example", "game", "quiz", "build", "reflection", "tutor_context"],
  "properties": {
    "id": {"type": "string", "pattern": "^L[0-9]{2}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"const": "authored"},
    "title": {"$ref": "#/$defs/text"},
    "zone": {"$ref": "#/$defs/text"},
    "minutes": {"type": "integer", "minimum": 5, "maximum": 90},
    "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L[0-9]{2}$"}},
    "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "prediction": {"$ref": "#/$defs/text"},
    "explanation": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/text"}},
    "analogy_limit": {"$ref": "#/$defs/text"},
    "python_example": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "expected_output", "walkthrough"],
      "properties": {
        "code": {"$ref": "#/$defs/text"},
        "expected_output": {"type": "string"},
        "walkthrough": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "title", "instructions", "pass_correct", "rounds"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "type": {"const": "choice_rounds"},
        "title": {"$ref": "#/$defs/text"}, "instructions": {"$ref": "#/$defs/text"},
        "pass_correct": {"const": 2},
        "rounds": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "quiz": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pass_correct", "questions"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "pass_correct": {"const": 2},
        "questions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "instructions", "criteria", "hints", "reference_solution"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "instructions": {"$ref": "#/$defs/text"},
        "criteria": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/text"}},
        "hints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/text"}},
        "reference_solution": {"$ref": "#/$defs/text"}
      }
    },
    "reflection": {"$ref": "#/$defs/text"},
    "tutor_context": {"$ref": "#/$defs/text"},
    "lab": {"type": "string", "enum": ["similarity", "attention", "training"]},
    "visual": {"$ref": "#/$defs/visual"}
  },
  "$defs": {
    "visualText": {"type": "string", "minLength": 1, "maxLength": 700},
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "inputs", "operation", "output", "limit", "frames", "challenge"],
      "properties": {
        "title": {"$ref": "#/$defs/visualText"},
        "inputs": {"$ref": "#/$defs/visualText"},
        "operation": {"$ref": "#/$defs/visualText"},
        "output": {"$ref": "#/$defs/visualText"},
        "limit": {"$ref": "#/$defs/visualText"},
        "frames": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"$ref": "#/$defs/visualFrame"}},
        "challenge": {
          "type": "object", "additionalProperties": false, "required": ["question", "choices"],
          "properties": {
            "question": {"$ref": "#/$defs/visualText"},
            "choices": {"type": "array", "minItems": 2, "maxItems": 3, "items": {
              "type": "object", "additionalProperties": false, "required": ["text", "correct", "feedback"],
              "properties": {"text": {"$ref": "#/$defs/visualText"}, "correct": {"type": "boolean"}, "feedback": {"$ref": "#/$defs/visualText"}}
            }}
          }
        }
      }
    },
    "visualFrame": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "explain", "lines", "layout", "items", "console"],
      "properties": {
        "title": {"$ref": "#/$defs/visualText"},
        "explain": {"$ref": "#/$defs/visualText"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "layout": {"type": "string", "enum": ["flow", "tokens", "bars", "memory", "checks", "chunks", "evidence"]},
        "console": {"type": "string", "maxLength": 4000},
        "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "value", "detail", "tone"],
          "properties": {
            "label": {"$ref": "#/$defs/visualText"}, "value": {"$ref": "#/$defs/visualText"},
            "detail": {"type": "string", "maxLength": 700},
            "tone": {"type": "string", "enum": ["neutral", "active", "success", "warning", "muted"]},
            "amount": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }}
      }
    },
    "text": {"type": "string", "minLength": 1},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "prompt", "choices", "correct_choice_id", "feedback"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "prompt": {"$ref": "#/$defs/text"},
        "choices": {
          "type": "array", "minItems": 3, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {"id": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/text"}}
          }
        },
        "correct_choice_id": {"$ref": "#/$defs/text"},
        "feedback": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
