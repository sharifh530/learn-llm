# Copy to .env locally. Never commit or share the filled file.
AI_ENABLED=false
AI_PROVIDER=google_cloud
# express_key: Cloud express key. adc: standard Cloud project + local ADC.
GOOGLE_AUTH_MODE=express_key
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Select a supported text model from your own Google project.
GOOGLE_MODEL=
